# assets/.env
# Environment variables for Vocifer app

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API Key (if different from manifest)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Prediction Service
PREDICTION_API_URL=https://your-model-server.com/predict
PREDICTION_API_TOKEN=your_api_token_here

# Firebase (optional - already in firebase_options.dart)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_API_KEY=your_api_key

# App Configuration
APP_NAME=Vocifer
APP_VERSION=1.0.0
ENVIRONMENT=development

# Note: Create this file in assets/.env
# Add .env to your .gitignore to keep secrets safe!